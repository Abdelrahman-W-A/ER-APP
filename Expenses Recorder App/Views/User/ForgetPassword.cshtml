@using Expenses_Recorder_App.Models.Application_Models.User
@model EnterEmailViewModel
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">

        <!-- Left side: ERP title -->
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
            <span class="text-success fw-bold fs-4">$</span>
            <span>Expense Recorder App</span>
        </a>

        <!-- Right side -->
        <div class="collapse navbar-collapse justify-content-end">
            <ul class="navbar-nav">

                <li class="nav-item">
                    <a class="nav-link" href="https://abdelrahmanwalid.runasp.net/" target="_blank">
                        Developer
                    </a>
                </li>

            </ul>
        </div>

    </div>
</nav>
<br />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white text-center">
                    <h4>Forget Password</h4>
                </div>

                <div class="card-body">

                    <form asp-action="ForgetPassword" method="post">

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Submit -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                Continue
                            </button>
                        </div>
                        <div class="d-grid">
                            <a asp-action="UserLogin" class="btn btn-outline-dark w-100 mt-2">Back To Login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>