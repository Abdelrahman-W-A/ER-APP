@using Expenses_Recorder_App.Models.Application_Models.User
@model UserCreateViewModel

@{
    ViewData["Title"] = "Create User";
}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">

        <!-- Left side: ERP title -->
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
            <span class="text-success fw-bold fs-4">$</span>
            <span>Expense Recorder App</span>
        </a>

        <!-- Right side -->
        <div class="collapse navbar-collapse justify-content-end">
            <ul class="navbar-nav">

                <li class="nav-item">
                    <a class="nav-link" href="https://abdelrahmanwalid.runasp.net/" target="_blank">
                        Developer
                    </a>
                </li>

            </ul>
        </div>

    </div>
</nav>
<br />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white text-center">
                    <h4>Create New User</h4>
                </div>

                <div class="card-body">

                    <form asp-action="CreateUser" method="post">

                        <!-- Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" type="password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- User Question -->
                        <div class="mb-3">
                            <label asp-for="UserQuestion" class="form-label">User Question</label>
                            <input asp-for="UserQuestion" class="form-control" />
                            <span asp-validation-for="UserQuestion" class="text-danger"></span>
                        </div>

                        <!-- User Answer -->
                        <div class="mb-3">
                            <label asp-for="UserAnswer" class="form-label">User Question Answer</label>
                            <input asp-for="UserAnswer" class="form-control" />
                            <span asp-validation-for="UserAnswer" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Salary" class="form-floating">Salary</label>
                            <input asp-for="Salary" class="form-control" />
                            <span asp-validation-for="Salary" class="text-danger"></span>
                        </div>

                        <!-- Submit -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                Create User
                            </button>
                        </div>

                        <!-- Cancel -->
                        <div class="d-grid">
                            <button type="button" class="btn btn-outline-dark w-100 mt-2" onclick="window.location.href='@Url.Action("UserLogin", "User")'">
                                Back to login
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>