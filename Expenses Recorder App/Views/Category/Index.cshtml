@using Expenses_Recorder_App.Models.Application_Models.Categories
@model IndexViewModel
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">

        <!-- Left side: ERP title -->
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
            <span class="text-success fw-bold fs-4">$</span>
            <span>Expense Recorder App</span>
        </a>

        <!-- Right side -->
        <div class="collapse navbar-collapse justify-content-end">
            <ul class="navbar-nav">


                <li class="nav-item">
                    <a class="nav-link" href="https://abdelrahmanwalid.runasp.net/" target="_blank">
                        Developer
                    </a>
                </li>

            </ul>
        </div>

    </div>
</nav>
<br>

<div class="container-fluid px-4">
    <!-- Tabs -->
    <div class="container-fluid px-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <!-- Tabs (left) -->
            <a asp-controller="Expense"
               asp-action="Index" class="btn btn-outline-dark">
                ← Back
            </a>

            @*                 <li class="nav-item">
                    <a class="nav-link px-4 rounded-pill shadow-sm @(currentController == "Category" ? "bg-dark text-white" : "text-dark")"
                       asp-controller="Category"
                       asp-action="Index">
                        Categories
                    </a>
                </li> *@

            <!-- Date & Time (right) -->
            @*             <div class="text-dark fw-semibold">
                <span id="currentDateTime"></span>
            </div> *@

        </div>

    </div>

    <!-- Category Table -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Total Categories</small>
                    <h3 class="fw-bold">@Model.CategoriesCount</h3>

                </div>
            </div>
        </div>
        <br>
        <div class="card shadow-sm">


            <div class="card-body">

                <div class="d-flex justify-content-between mb-3">
                    <div>
                        <h5 class="mb-0">Categories</h5>
                    </div>

                    <a asp-action="Create" class="btn btn-dark">
                        + Add Category
                    </a>
                </div>


                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Note</th>
                            <th class="text-md-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            foreach (var category in Model.Categories)
                            {
                                <tr>
                                    <td>
                                        @category.Name
                                    </td>
                                    <td class="text-success fw-bold">
                                        @category.Note
                                    </td>
                                    <td class="text-md-center">
                                        <a asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="btn btn-outline-warning btn-sm me-2">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@category.Id"
                                           class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center">No categories available.</td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<script>
    function updateDateTime() {
        const now = new Date();

        const options = {
            weekday: 'short',
            year: 'numeric',
            month: 'short',
            day: 'numeric'
        };

        const date = now.toLocaleDateString(undefined, options);
        const time = now.toLocaleTimeString();

        document.getElementById("currentDateTime").textContent = `${date} | ${time}`;
    }

    setInterval(updateDateTime, 1000);
    updateDateTime(); // initial call
</script>