@using Expenses_Recorder_App.Models.Application_Models.Expenses
@model ExpenseViewModel
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
@{
    ViewData["Title"] = "Expenses";
}

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">

        <!-- Left side: ERP title -->
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
            <span class="text-success fw-bold fs-4">$</span>
            <span>Expense Recorder App</span>
        </a>

        <!-- Right side -->
        <div class="collapse navbar-collapse justify-content-end">
            <ul class="navbar-nav">

                <li class="nav-item">
                    <a class="nav-link" href="https://abdelrahmanwalid.runasp.net/" target="_blank">
                        Developer
                    </a>
                </li>

            </ul>
        </div>

    </div>
</nav>
<br />
<div class="container-fluid px-4">

    <!-- Tabs -->
    <div class="container-fluid px-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <!-- Tabs (left) -->
            <ul class="nav nav-pills gap-2 mb-0">

                <li class="nav-item">
                    <a class="nav-link px-4 rounded-pill shadow-sm @(currentController == "Expense" ? "bg-dark text-white" : "text-dark")"
                       asp-controller="Expense"
                       asp-action="Index">
                        Expenses
                    </a>
                </li>
                @* 
                <li class="nav-item">
                    <a class="nav-link px-4 rounded-pill shadow-sm @(currentController == "Category" ? "bg-dark text-white" : "text-dark")"
                       asp-controller="Category"
                       asp-action="Index">
                        Categories
                    </a>
                </li> *@

            </ul>
            <div class="text-dark fw-semibold card shadow-sm">
                <span id="currentDateTime"></span>
            </div>

            <div class="d-flex gap-2 ">
                <!-- Date & Time (right) -->

                <div>
                    <a asp-controller="User" asp-action="UserLogin" class="btn btn-danger"> <i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                </div>
            </div>
        </div>

    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Monthly Total Salary</small>
                    <h3 class="fw-bold">$@Model.MonthSalary</h3>
                    <a asp-action="ChangeSalary" class="btn btn-outline-primary btn-sm">Change</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Monthly Total Remaining Salary</small>
                    <h3 class="fw-bold">$@Model.RemainingSalary</h3>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Monthly Total</small>
                    <h3 class="fw-bold">$@Model.MonthlyTotal</h3>
                    <small>@Model.Expenses.Count expenses</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Yearly Total</small>
                    <h3 class="fw-bold">$@Model.YearlyTotal</h3>
                    <small>@Model.SelectedDate.Year</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Categories</small>
                    <h3 class="fw-bold">@Model.CategoriesCount</h3>
                </div>
            </div>
        </div>

        <form asp-action="Index" method="get">
            <div class="card shadow-sm">
                <div class="card-body">

                    <small class="text-muted">Filter Month</small>

                    <input type="month"
                           name="SelectedDate"
                           class="form-control mt-2"
                           value="@Model.SelectedDate.ToString("yyyy-MM")"
                           onchange="this.form.submit()" />

                </div>
            </div>
        </form>
    </div>

    <!-- Expenses Table -->
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between mb-3">
                <div>
                    <h5 class="mb-0">Expenses</h5>
                    <small class="text-muted">
                        Showing expenses for @Model.SelectedDate.ToString("MMMM yyyy")
                    </small>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Category" asp-action="Index" class="btn btn-primary">Categories</a>
                    <a asp-action="Create" class="btn btn-dark">
                        + Add Expense
                    </a>
                </div>
            </div>

            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Note</th>
                        <th class="text-md-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Expenses.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-wallet2 fs-1"></i>
                                <div>No expenses recorded for this month.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var expense in Model.Expenses)
                        {
                            <tr>
                                <td class="fw-semibold">@expense.Category.Name</td>
                                <td>
                                    <i class="bi bi-calendar"></i>
                                    @expense.Date.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-success fw-bold">
                                    $ @expense.Amount
                                </td>
                                <td>
                                    <i class="bi bi-file-text"></i>
                                    @expense.Note
                                </td>
                                <td class="text-md-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@expense.Id"
                                       class="btn btn-outline-warning btn-sm me-2">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@expense.Id"
                                       class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>

<script>
    function updateDateTime() {
        const now = new Date();

        const options = {
            weekday: 'short',
            year: 'numeric',
            month: 'short',
            day: 'numeric'
        };

        const date = now.toLocaleDateString(undefined, options);
        const time = now.toLocaleTimeString();

        document.getElementById("currentDateTime").textContent = `${date} | ${time}`;
    }

    setInterval(updateDateTime, 1000);
    updateDateTime(); // initial call
</script>
