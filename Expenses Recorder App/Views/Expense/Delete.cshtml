<br />

<div class="container-fluid px-4">
<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-4">
            <div>
                <h5 class="mb-0">Delete Expense</h5>
                <small class="text-muted
                    ">Are you sure you want to delete this expense?</small>
            </div>
        </div>
            <form asp-action="DeleteConfirmed" method="post">

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="alert alert-warning mt-3">
                    <strong>Amount:</strong> @Model.Amount <br />
                    <strong>Date:</strong> @Model.Date.ToShortDateString() <br />
                    <strong>Category:</strong> @Model.Category?.Name <br />
                    <strong>Note:</strong> @Model.Note
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete Expense
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>
            </form>
    </div>
</div>
</div>
